# Environment Variables for Wrencos Chat Assistant

# Cloudinary Configuration (required for persistent image/thumbnail uploads)
# Sign up free at: https://cloudinary.com/users/register/free
# Find these in your Cloudinary Dashboard > Settings > Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 Configuration (required for livestream video storage — free 10 GB, zero egress)
# Setup steps:
# 1. Go to https://dash.cloudflare.com > R2 Object Storage > Create bucket (e.g. "wrencos-livestreams")
# 2. In bucket Settings > Public Access, enable "R2.dev subdomain" (gives you R2_PUBLIC_URL)
# 3. Go to R2 Overview > Manage R2 API Tokens > Create API Token (Object Read & Write)
# 4. Copy Account ID from R2 Overview page (top right)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wrencos-livestreams
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Google Gemini API Configuration (required for AI chat functionality)
GEMINI_API_KEY= 'your-GEMINI_API_KEY'

# ElevenLabs AI Voice Configuration (optional - for natural voice in Live Chat AI)
# Get FREE API key from: https://elevenlabs.io/sign-up
# Free Tier: 10,000 characters/month (~10 minutes of audio)
# Instructions:
# 1. Sign up at https://elevenlabs.io/sign-up
# 2. Go to Profile Settings > API Keys
# 3. Copy your API key and paste it below
# 4. Leave blank to use gTTS (free unlimited but robotic voice)
ELEVENLABS_API_KEY=

# MongoDB Configuration (if not already set)
MONGODB_URI=mongodb+srv://mongo-api:'your_password'@cluster0.18pi3.mongodb.net/Wrencos?retryWrites=true&w=majority

# JWT Configuration (if not already set)
JWT_SECRET=your_jwt_secret_here

# Application Configuration
NODE_ENV=development
PORT=3000

# Email Configuration (Gmail SMTP)
# Instructions:
# 1. Use your Gmail address
# 2. Generate an App Password (not your regular password):
#    - Go to Google Account settings
#    - Security > 2-Step Verification (must be enabled)
#    - App passwords > Select app: Mail > Generate password
#    - Use the 16-character password here
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
COMPANY_NAME=Wrencos
FRONTEND_URL=http://localhost:5173

VNP_TMN_CODE=your_sandbox_tmn_code
VNP_HASH_SECRET=your_sandbox_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payments/vnpay/return

# ===================================
# Marketing Automation Services
# ===================================

# Twilio SMS Service (for Marketing Automation Workflows)
# Get credentials from: https://www.twilio.com/console
# Without these, SMS will run in mock mode (logs only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Push Notifications (for Marketing Automation Workflows)
# Get credentials from: https://console.firebase.google.com/
# Option 1: Use service account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# Option 2: Use individual environment variables
# (Private key should be base64 encoded: echo -n "key" | base64)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=base64_encoded_private_key_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
